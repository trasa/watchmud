# Copy to deploy/.env and fill in. deploy/.env is git- and docker-ignored:
# it holds the database passwords.
#
# Long random ones: openssl rand -base64 24 | tr -d '/+='
# (no / + or =, which would need escaping in the mongo uri)

# mongo's root user: backups, and you in `make` / mongosh. Not the game.
MONGO_ROOT_PASSWORD=

# the user the game connects as, read/write on its own database only.
# Only takes effect when mongo's volume is first created -- see README.
WATCHMUD_DB_PASSWORD=

# the port players telnet to
WATCHMUD_PORT=4000

# nightly, two weeks
BACKUP_EVERY_SECONDS=86400
BACKUP_KEEP_DAYS=14

# Off-droplet copies of the backups, in a DigitalOcean Spaces bucket. Put the
# bucket in a different region from the droplet (which is sfo3). The key is a
# Spaces access key limited to that one bucket. See README, "Backups".
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# hourly, and the bucket keeps 90 days
OFFSITE_EVERY_SECONDS=3600
OFFSITE_KEEP_DAYS=90
